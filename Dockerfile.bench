FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc-14 g++-14 \
    cmake \
    pkg-config \
    liburing-dev \
    libgflags-dev \
    libboost-context-dev \
    libssl-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

ENV CC=gcc-14
ENV CXX=g++-14

# Install oha based on architecture
RUN if [ "$(uname -m)" = "aarch64" ]; then \
        curl -L https://github.com/hatoo/oha/releases/latest/download/oha-linux-arm64 -o /usr/local/bin/oha; \
    else \
        curl -L https://github.com/hatoo/oha/releases/latest/download/oha-linux-amd64 -o /usr/local/bin/oha; \
    fi && \
    chmod +x /usr/local/bin/oha

WORKDIR /app

# Copy project files
COPY . /app

# Build the project
RUN rm -rf build && mkdir -p build && cd build && cmake -DKIO_BUILD_HTTP_BENCH=ON -DKIO_BUILD_DEMOS=OFF -DKIO_BUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release .. && sed -i 's/io_uring_prep_ftruncate(sqe, raw_fd, len)/io_uring_prep_nop(sqe)/g' /app/include/uring/core/io.h && sed -i 's/io_uring_prep_ftruncate(sqe, fd.fd, len)/io_uring_prep_nop(sqe)/g' /app/include/uring/core/fiber_io.hpp && make kio_http_bench kio_fiber_http_bench -j$(nproc)

# Default command
CMD ["./bench_kio.sh"]
