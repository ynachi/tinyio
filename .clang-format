---
Language: Cpp
BasedOnStyle: Google
Standard: Latest

ColumnLimit: 100
IndentWidth: 4
AccessModifierOffset: -4
DerivePointerAlignment: false
IndentPPDirectives: AfterHash

# Every body gets braces and its own line: no `if (x) return;` that the next
# edit silently turns into a two-statement body.
InsertBraces: true
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Include groups, in order: the file's own header (clang-format finds it),
# C system, C++ standard library, third-party, tinyio, other local headers.
# The first matching rule wins.
IncludeBlocks: Regroup
IncludeCategories:
  # liburing.h would otherwise pass for a C system header.
  - Regex: '^<liburing'
    Priority: 3
  # <fcntl.h>, <sys/eventfd.h>, <linux/futex.h>
  - Regex: '^<([a-z0-9_]+|sys/.+|linux/.+|arpa/.+|netinet/.+|net/.+)\.h>$'
    Priority: 1
  # <vector>
  - Regex: '^<[a-z0-9_]+>$'
    Priority: 2
  # tinyio itself, in either spelling.
  - Regex: '^[<"]tinyio/'
    Priority: 4
  # <ylt/easylog.hpp>, <gtest/gtest.h>, <gflags/gflags.h>
  - Regex: '^<'
    Priority: 3
  - Regex: '^"'
    Priority: 5
