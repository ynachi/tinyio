@PACKAGE_INIT@

# tinyio's public headers include <ylt/easylog.hpp> and <liburing.h>.
# YLT installs its own headers into the same include directory as tinyio's,
# so liburing is what a consumer still has to provide.
include(CMakeFindDependencyMacro)

find_dependency(Threads)

# The exported target links tinyio::liburing. The build tree points it at the
# pinned liburing it compiles in place; installed, it is the system liburing,
# found through pkg-config.
if (NOT TARGET tinyio::liburing)
    find_dependency(PkgConfig)
    pkg_check_modules(LibUring REQUIRED IMPORTED_TARGET liburing>=2.9)
    add_library(tinyio::liburing INTERFACE IMPORTED)
    target_link_libraries(tinyio::liburing INTERFACE PkgConfig::LibUring)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/tinyio-targets.cmake")

check_required_components(tinyio)
